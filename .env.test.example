# Copy to .env.test:  cp .env.test.example .env.test
# Read only by Vitest (vitest.config.mts and tests/global-setup.ts); never by the
# app or the Prisma CLI defaults. It must point at the disposable
# bookleaf-db-test container: the test harness refuses any other database.
# Throwaway local-dev credentials from docker-compose.yml, not secrets.
DATABASE_URL="postgresql://bookleaf:bookleaf_local@127.0.0.1:55433/bookleaf_test"
