# Copy to .env for local development:  cp .env.example .env
# Never commit real values. All variables are server-side only; none may use the
# NEXT_PUBLIC_ prefix (that would inline them into the browser bundle).
# Validated by src/server/env.ts. Empty values count as "not set".

# --- Database (PostgreSQL via Prisma) ---
# Development uses a Neon project (Neon console -> Connect). Put real values in
# .env only, never here:
#   DATABASE_URL  pooled string (host contains "-pooler"); used by the app
#   DIRECT_URL    direct string (pooling off); used by migrations, seed, verify
#   DEV_DATABASE_HOST  the DIRECT_URL host; registers it as the dev database
#                      so the guards accept it (prisma/db-target.ts)
# DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"
# DEV_DATABASE_HOST="ep-XXXX.REGION.aws.neon.tech"
#
# Alternative: the local bookleaf-db-dev Docker container (`npm run db:up`),
# using throwaway local-dev credentials from docker-compose.yml (not secrets):
DATABASE_URL="postgresql://bookleaf:bookleaf_local@127.0.0.1:55432/bookleaf_dev"
DIRECT_URL=
DEV_DATABASE_HOST=

# --- Auth (required from T2.3) ---
# At least 32 characters. Generate with: openssl rand -base64 48
# Use a different value per environment.
AUTH_JWT_SECRET=

# --- AI (optional) ---
# AI is on only when all three are set; otherwise tickets are still created
# and admins reply manually. Verified on the free tier (see architecture §6.2):
#   GEMINI_CLASSIFY_MODEL=gemini-3.5-flash-lite
#   GEMINI_DRAFT_MODEL=gemini-3.5-flash-lite
# Check the configuration with: npm run ai:smoke (2 live calls).
GEMINI_API_KEY=
GEMINI_CLASSIFY_MODEL=
GEMINI_DRAFT_MODEL=
# Optional: override AI timeouts in ms (defaults: 15000 classify, 30000 draft).
AI_TIMEOUT_MS=

# --- Seed script only (T1.6, T2.2) ---
# The dataset JSON stays local and git-ignored.
SEED_DATA_PATH=./bookleaf_sample_data.json
# Demo login passwords (8+ characters), documented in the README. All dataset
# authors share the author password; the two support admins share the admin one.
# Re-seeding keeps existing hashes; `npx prisma db seed -- --reset-passwords`
# re-hashes them from these values.
SEED_AUTHOR_PASSWORD=
SEED_ADMIN_PASSWORD=
